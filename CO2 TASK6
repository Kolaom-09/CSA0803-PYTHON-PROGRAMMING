from functools import lru_cache
import sys

calls = 0


# 1. Normal recursion
def ways_naive(n):

    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_naive(n - 1) + ways_naive(n - 2)


# 2. Memoisation
@lru_cache(maxsize=None)
def ways_memo(n):

    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_memo(n - 1) + ways_memo(n - 2)


# 3. Iterative method
def ways_loop(n):

    if n <= 1:
        return 1

    a, b = 1, 1

    for i in range(2, n + 1):

        a, b = b, a + b

    return b


# Verify answers from 1 to 6
print("Manual Verification:")

for n in range(1, 7):
    print(n, "steps =", ways_loop(n))


# Compare function calls
for n in [10, 20, 25, 30]:

    calls = 0
    result1 = ways_naive(n)
    naive_calls = calls

    ways_memo.cache_clear()

    calls = 0
    result2 = ways_memo(n)
    memo_calls = calls

    print("\nn =", n)
    print("Naive:", result1, "Calls:", naive_calls)
    print("Memo :", result2, "Calls:", memo_calls)


# Test 1000 steps using loop
print("\n1000 Steps:")
print("Ways:", ways_loop(1000))

print("Recursion limit:", sys.getrecursionlimit())


# Test memoised recursion
ways_memo.cache_clear()

try:
    print("Memoised result:", ways_memo(1000))

except RecursionError:
    print("RecursionError: Maximum recursion depth exceeded.")
