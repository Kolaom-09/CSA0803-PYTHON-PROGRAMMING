import time

calls = 0


# Original recursive program
def original(n):

    global calls
    calls += 1

    if n <= 1:
        return 1

    return original(n - 1) + original(n - 2)


# Redesigned iterative program
def redesigned(n):

    if n <= 1:
        return 1

    a = 1
    b = 1

    for i in range(2, n + 1):

        a, b = b, a + b

    return b


# Compare both programs
n = 30

calls = 0

start = time.perf_counter()
result1 = original(n)
time1 = time.perf_counter() - start

start = time.perf_counter()
result2 = redesigned(n)
time2 = time.perf_counter() - start

print("Original Result:", result1)
print("Redesigned Result:", result2)

print("Original Function Calls:", calls)
print("Redesigned Loop Iterations:", max(0, n - 1))

print("Original Time:", time1)
print("Redesigned Time:", time2)

print("\nFor 1000 Steps:")
print("Number of ways:", redesigned(1000))

if result1 == result2:
    print("Validation: SUCCESS")
else:
    print("Validation: FAILED")
