def add_item_buggy(item, order=[]):
    order.append(item)
    return order


def add_item(item, order=None):

    if order is None:
        order = []

    order.append(item)

    return order


# Testing buggy function
print("Buggy Function:")

print(add_item_buggy("Tea"))
print(add_item_buggy("Vada"))

print("Default values:", add_item_buggy.__defaults__)


# Testing corrected function
print("\nCorrected Function:")

print(add_item("Tea"))
print(add_item("Vada"))


# Three customers
customer1 = add_item("Tea")
customer2 = add_item("Coffee")
customer3 = add_item("Juice")

print("\nCustomer Orders:")
print("Customer 1:", customer1)
print("Customer 2:", customer2)
print("Customer 3:", customer3)


# Function with multiple return values
def calculate_bill(amount):

    gst = amount * 0.05
    total = amount + gst

    return total, gst


total, gst = calculate_bill(500)

print("\nTotal Bill:", total)
print("GST:", gst)
